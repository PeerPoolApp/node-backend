NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Browser origins (comma-separated). Local Vite (5173–5177, localhost + 127.0.0.1)
# and Capacitor WebView origins are always merged in code even if omitted here.
# Use one line only — a second CORS_ORIGIN= in .env overwrites the first.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,https://vue-frontend-git-testing-felixwwork-9107s-projects.vercel.app

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Web Push (browser/PWA only) — optional; APK uses FCM instead
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@peerpool.at

# Firebase Cloud Messaging (Android Capacitor) — single-line service account JSON
# Firebase Console → Project settings → Dienstkonten → Neuen privaten Schlüssel generieren
# Also place google-services.json at vue-frontend/android/app/ (package at.peerpool.app)
FCM_SERVICE_ACCOUNT_JSON=
